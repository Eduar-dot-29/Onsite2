# Environment variables for On-site On-Transit backend
# Note: pydantic-settings automatically maps UPPERCASE env vars to lowercase Settings fields
# Example: DATABASE_URL -> database_url, JWT_SECRET -> jwt_secret

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tracking

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=change-me-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Telegram Integration (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321

# Worker Automation Settings
SILENCE_TOLERANCE_MINUTES=30
AVERAGE_SPEED_KMH=80

# Routing Provider (optional)
ROUTING_PROVIDER=stub
ROUTING_API_KEY=

# Application Settings
APP_NAME=on-site-on-transit
ENVIRONMENT=local
